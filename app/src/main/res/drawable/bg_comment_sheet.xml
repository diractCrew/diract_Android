        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/stroke_strong" />
        </shape>
    </item>

    <item
        android:gravity="top"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/background_elevated" />
        </shape>
    </item>

</layer-list>

