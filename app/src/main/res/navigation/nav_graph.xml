<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.baek.diract.presentation.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_projectListFragment"
            app:destination="@id/projectListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_manageTeamspaceFragment"
            app:destination="@id/manageTeamspaceFragment" />
        <action
            android:id="@+id/action_homeFragment_to_video_nav_graph"
            app:destination="@id/video_nav_graph">
            <argument
                android:name="tracksId"
                app:argType="string" />
            <argument
                android:name="tracksTitle"
                app:argType="string" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/manageTeamspaceFragment"
        android:name="com.baek.diract.presentation.home.ManageTeamspaceFragment"
        android:label="ManageTeamspaceFragment"
        tools:layout="@layout/fragment_manage_teamspace" />
    <fragment
        android:id="@+id/inboxFragment"
        android:name="com.baek.diract.presentation.inbox.InboxFragment"
        android:label="fragment_inbox"
        tools:layout="@layout/fragment_inbox">
        <action
            android:id="@+id/action_inboxFragment_to_videoPlayerFragment"
            app:destination="@id/videoPlayerFragment" />
    </fragment>
    <include app:graph="@navigation/mypage_nav_graph" />

    <!-- 푸시 알림 딥링크용 글로벌 액션 -->
    <action
        android:id="@+id/action_global_to_videoPlayerFragment"
        app:destination="@id/videoPlayerFragment" />

    <fragment
        android:id="@+id/videoPlayerFragment"
        android:name="com.baek.diract.presentation.home.video.player.VideoPlayerFragment"
        android:label="fragment_video_player"
        tools:layout="@layout/fragment_video_player">
        <argument
            android:name="videoId"
            app:argType="string" />
        <argument
            android:name="videoTitle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="tracksTitle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="teamspaceId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <include app:graph="@navigation/video_nav_graph" />
</navigation>
