<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mypage_nav_graph"
    app:startDestination="@id/myPageFragment">

    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.baek.diract.presentation.mypage.MyPageFragment"
        android:label="fragment_my_page"
        tools:layout="@layout/fragment_my_page">

        <action
            android:id="@+id/action_myPageFragment_to_inquiryFragment"
            app:destination="@id/inquiryFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_editUserNameFragment"
            app:destination="@id/editUserNameFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_accountSettingFragment"
            app:destination="@id/accountSettingFragment" />
    </fragment>

    <fragment
        android:id="@+id/inquiryFragment"
        android:name="com.baek.diract.presentation.mypage.InquiryFragment"
        android:label="fragment_inquiry"
        tools:layout="@layout/fragment_inquiry" />
    <fragment
        android:id="@+id/editUserNameFragment"
        android:name="com.baek.diract.presentation.mypage.EditUserNameFragment"
        android:label="fragment_edit_user_name"
        tools:layout="@layout/fragment_edit_user_name" />
    <fragment
        android:id="@+id/accountSettingFragment"
        android:name="com.baek.diract.presentation.mypage.AccountSettingFragment"
        android:label="fragment_account_setting"
        tools:layout="@layout/fragment_account_setting" />
</navigation>
