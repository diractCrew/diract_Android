<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_elevated"
    tools:context=".presentation.common.dialog.InputDialogFragment">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:text="@string/create_teamspace"
            android:id="@+id/titleTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:layout_weight="1"
            android:textAppearance="@style/Title2.Medium" />
        <!-- 닫기 버튼 -->
        <ImageButton
            android:id="@+id/closeBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/dialog_cancel"
            android:src="@drawable/ic_close"
            app:tint="@color/label_strong" />
    </LinearLayout>

    <!-- 설명 라벨 -->

    <LinearLayout
        android:id="@+id/btnLaterState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/actionContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.98">

        <TextView
            android:id="@+id/btnInviteLater"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/teamspace_invite_later"
            android:textAppearance="@style/Headline2.Medium"
            android:textColor="@color/secondary_normal"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyMember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.378">


        <ImageView
            android:id="@+id/ivEmptyMember"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:clickable="true"
            android:contentDescription="@string/create_teamspace"
            android:focusable="true"
            android:src="@drawable/ic_group" />

        <TextView
            android:id="@+id/tvInviteMember1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:gravity="center"
            android:text="@string/teamspace_invite_title"
            android:textAppearance="@style/Title2.Semibold"
            android:textColor="@color/label_strong" />

        <TextView
            android:id="@+id/tvInviteMember2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/teamspace_invite_message"
            android:textAppearance="@style/Headline2.Medium"
            android:textColor="@color/label_normal"
            android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/actionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_action_container"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inviteBtn"
            android:text="@string/teamspace_invite"
            style="@style/Widget.Diract.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Diract.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/secondary_normal"
                app:indicatorSize="28dp"
                app:trackColor="@android:color/transparent"
                app:trackThickness="4dp" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/completeView"
            style="@style/Widget.Diract.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/fill_normal"
            android:enabled="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textAppearance="@style/Headline2.Semibold"
            android:visibility="gone"
            app:cornerRadius="15dp"
            app:icon="@drawable/ic_check_circle_stroke"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/secondary_normal" />
    </FrameLayout>

    <View
        android:id="@+id/blockingView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
